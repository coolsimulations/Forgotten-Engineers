{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_desc}",
  "authors": [ "coolsim" ],

  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_source}",
    "issues": "${mod_issues}"
  },

  "license": "${mod_license}",
  "icon": "${mod_id}_icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.coolsimulations.ForgottenEngineers.ForgottenEngineers"
    ],
    "client": [
      "net.coolsimulations.ForgottenEngineers.ForgottenEngineersClient"
    ],
    "fabric-datagen": [
      "net.coolsimulations.ForgottenEngineers.data.ForgottenEngineersDataGeneration"
    ]
  },

  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.common.mixins.json"
  ],

  "accessWidener": "forgottenengineers.accesswidener",

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_x_version}"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/7DDsHfQ"
      }
    },
    "configured": {
      "configs": [],
      "background": "minecraft:textures/block/anvil.png"
    },
    "catalogue": {
      "banner": "${mod_id}_catalogue_icon.png",
      "background": "${mod_id}_catalogue_background.png"
    }
  }
}